# SMTP credentials for signup OTPs, password resets, and notifications.
MAIL_HOST=
MAIL_USER=
MAIL_PASS=
# Cloudinary credentials for course images, videos, and profile uploads.
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=BharatVidyapeeth
# Razorpay test credentials for local development.
RAZORPAY_KEY=
RAZORPAY_SECRET=
